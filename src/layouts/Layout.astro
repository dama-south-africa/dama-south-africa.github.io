---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  title: string;
  description?: string;
  image?: string;
  faq?: FaqItem[];
}

const {
  title,
  description = 'DAMA South Africa is the local chapter of DAMA International — a community of data professionals advancing data management through meetings, special interest groups, CDMP certification and mentoring.',
  image = '/og-image.png',
  faq,
} = Astro.props;

const site = Astro.site ?? new URL('https://dama-south-africa.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const logoUrl = new URL('/logo.png', site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'EducationalOrganization'],
  name: 'DAMA South Africa',
  alternateName: ['Data Management Association South Africa', 'DAMA SA'],
  url: site.href,
  logo: logoUrl,
  image: ogImage,
  foundingDate: '2006',
  description:
    'The South African chapter of DAMA International — a community of technical and business professionals advancing the concepts and practices of information and data management.',
  email: 'membership@dama.org.za',
  areaServed: { '@type': 'Country', name: 'South Africa' },
  parentOrganization: {
    '@type': 'Organization',
    name: 'DAMA International',
    url: 'https://dama.org/',
  },
  sameAs: [
    'https://za.linkedin.com/company/damasouthernafrica',
    'https://www.meetup.com/dama-sa-data-management-meetup/',
    'https://dama.org/',
  ],
};

const faqSchema =
  faq && faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b3a5b" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DAMA South Africa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_ZA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <!-- Classic professional type: Libre Franklin -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
