---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <svg class="net" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
    <circle cx="100" cy="100" r="94" />
    <ellipse cx="100" cy="100" rx="30" ry="94" />
    <ellipse cx="100" cy="100" rx="62" ry="94" />
    <line x1="6" y1="100" x2="194" y2="100" />
    <path d="M20 56 H180" /><path d="M20 144 H180" />
    <path d="M36 30 H164" /><path d="M36 170 H164" />
  </svg>
  <div class="container">
    <div class="section-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {lead && <p class="lead" set:html={lead} />}
    </div>
  </div>
</section>
