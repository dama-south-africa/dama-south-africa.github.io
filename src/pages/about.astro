---
import Layout from '../layouts/Layout.astro';

const faq = [
  {
    q: 'What is DAMA South Africa?',
    a: 'DAMA South Africa is the South African chapter of DAMA International, a community of technical and business professionals dedicated to advancing the concepts and practices of information and data management. The chapter was established in 2006.',
  },
  {
    q: 'When are the chapter meetings?',
    a: 'The chapter meets on the third Wednesday of every month, with educational presentations, discussion of data management topics, and networking with fellow practitioners.',
  },
  {
    q: 'What is the CDMP certification?',
    a: 'The Certified Data Management Professional (CDMP) is DAMA International\u2019s professional certification. DAMA South Africa offers guidance and support on the CDMP pathways at every level.',
  },
  {
    q: 'What special interest groups does DAMA South Africa run?',
    a: 'The chapter runs three special interest groups: data protection, big data & data science, and data modeling.',
  },
  {
    q: 'Does DAMA South Africa offer mentoring?',
    a: 'Yes. DAMA South Africa connects experienced practitioners with data professionals who are growing their careers.',
  },
  {
    q: 'How do I become a member?',
    a: 'Visit the Become a Member page or email membership@dama.org.za to join the community.',
  },
];
---

<Layout
  title="About — DAMA South Africa"
  description="Learn about DAMA South Africa — our mission, CDMP certification guidance, mentoring, and the special interest groups advancing data management practice since 2006."
  faq={faq}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">About us</span>
        <h1>About DAMA South Africa</h1>
        <p class="lead">
          DAMA South Africa is a local chapter of DAMA International, the global
          not-for-profit association for data management professionals.
        </p>
      </div>
      <div class="prose">
        <p>
          Our mission is to promote the understanding, development and practice
          of managing data and information as key enterprise assets. Established
          in 2006, the chapter hosts monthly meetings featuring educational
          presentations and networking opportunities, and nurtures a community
          of data professionals who recognise the value of data to their
          organisations.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Supporting data professionals</h2>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <h3>Knowledge sharing</h3>
          <p>Special interest groups and monthly meetings where members exchange practical experience across data management disciplines.</p>
        </div>
        <div class="card">
          <h3>CDMP certification</h3>
          <p>Guidance on the Certified Data Management Professional programme and its certification levels.</p>
        </div>
        <div class="card">
          <h3>Mentoring</h3>
          <p>Initiatives that pair experienced practitioners with professionals developing their data management careers.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
