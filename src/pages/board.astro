---
import Layout from '../layouts/Layout.astro';

const board = [
  {
    name: 'Howard Diesel',
    role: 'President',
    photo: '/howard-diesel.jpg',
    linkedin: 'https://za.linkedin.com/in/howarddiesel-cdmp-dmbok-modelwaresystems',
  },
  {
    name: 'Abeda Essop',
    role: 'Vice President',
    photo: '/abeda-essop.jpg',
    linkedin: 'https://www.linkedin.com/in/abeda-essop-79a216a/',
  },
  {
    name: 'Veronica Diesel',
    role: 'Membership Services & Education',
    photo: '/veronica-diesel.jpg',
    linkedin: 'https://www.linkedin.com/in/veronica-diesel-68b52b77/',
  },
  {
    name: 'Paul Grobler',
    role: 'Ethics Officer',
    photo: '/paul-grobler.jpg',
    linkedin: 'https://www.linkedin.com/in/pgrobler101/',
  },
  {
    name: 'Siyabonga Nene',
    role: 'Digital & Events',
    photo: null,
    linkedin: null,
  },
];
---

<Layout title="Board — DAMA South Africa">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Leadership</span>
        <h1>Meet the Board</h1>
        <p class="lead">
          DAMA South Africa is run by a volunteer board of data management
          practitioners.
        </p>
      </div>

      <div class="board-grid">
        {
          board.map((m) => (
            <div class="board-card">
              {m.photo ? (
                <img
                  class="board-photo"
                  src={m.photo}
                  alt={m.name}
                  width="150"
                  height="150"
                  loading="lazy"
                />
              ) : (
                <div class="board-photo placeholder" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21a8 8 0 0 1 16 0" />
                  </svg>
                </div>
              )}
              <h3>{m.name}</h3>
              <p class="role">{m.role}</p>
              {m.linkedin && (
                <a
                  class="board-linkedin"
                  href={m.linkedin}
                  rel="noopener"
                  target="_blank"
                  aria-label={`${m.name} on LinkedIn`}
                >
                  <svg viewBox="0 0 448 512" fill="currentColor" width="18" height="18" aria-hidden="true">
                    <path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
                  </svg>
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2.5rem 1.5rem;
    max-width: 1000px;
  }
  .board-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .board-photo {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: 0 auto 1rem;
    border: 3px solid var(--blue-tint);
  }
  .board-photo.placeholder {
    display: grid;
    place-items: center;
    background: #e5e8f0;
    color: #9aa3b2;
  }
  .board-photo.placeholder svg {
    width: 66px;
    height: 66px;
  }
  .board-card h3 {
    margin: 0 0 0.15rem;
    font-size: 1.1rem;
  }
  .board-card .role {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.35;
    /* reserve space for up to two lines so the badges all align */
    min-height: 2.9em;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .board-linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    margin-top: 0.5rem;
    border-radius: 6px;
    background: #0a66c2; /* official LinkedIn blue */
    color: #fff;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .board-linkedin:hover {
    background: #004182;
    transform: translateY(-1px);
  }
  .board-linkedin svg {
    width: 13px;
    height: 13px;
  }
</style>
