---
import Layout from '../layouts/Layout.astro';

const benefits = [
  'Attend every monthly online chapter meeting and presentation',
  'Take part in the special interest groups — data protection, big data & data science, and data modeling',
  'CDMP certification support: guidance, a weekly Q&A webinar, and partner training',
  'Mentoring and networking with data professionals across industries',
  'A monthly newsletter with chapter news, events and data management insights',
  'Connection to the global DAMA International community and the DMBOK',
];

// Online membership join portal — create a DAMA profile.
const joinUrl =
  'https://join.mymembership.co.za/Join/Bio?communityId=3eb77fbc-7cc9-4365-adea-e50a1ce04b95';

const faq = [
  {
    q: 'How much does DAMA South Africa membership cost?',
    a: 'Standard individual membership is R450 per year.',
  },
  {
    q: 'Who can join DAMA South Africa?',
    a: 'Membership is open to anyone with an interest in data management — practitioners and specialists, managers and team leads, and professionals moving into the field.',
  },
  {
    q: 'How do I join DAMA South Africa?',
    a: 'You join online in a few minutes through the membership portal — click "Create a DAMA profile" on the Become a Member page and follow the steps. The committee will then be in touch to help you get involved.',
  },
  {
    q: 'Does DAMA South Africa offer corporate membership?',
    a: 'There is no corporate membership, but organisations can request Corporate Certificates. Email membership@dama.org.za to arrange.',
  },
];
---

<Layout
  title="Become a Member — DAMA South Africa"
  description="Join DAMA South Africa for R450 a year — a network of data management professionals with chapter meetings, SIGs, CDMP support, mentoring and the global DAMA community."
  faq={faq}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Membership</span>
        <h1>Become a Member</h1>
        <p class="lead">
          Join a community of data management practitioners across South Africa
          and take part in everything the chapter offers.
        </p>
      </div>

      <div class="grid grid-2">
        <div class="prose">
          <h2>Why join</h2>
          <ul>
            {benefits.map((b) => <li>{b}</li>)}
          </ul>
          <p>
            Membership suits anyone serious about data management —
            practitioners and specialists, managers and team leads, and
            professionals moving into the field. It's open to everyone with an
            interest in data management.
          </p>
        </div>
        <div class="card">
          <h2>Ready to join?</h2>
          <p class="meta">R450 per year · individual membership</p>
          <p>
            Standard individual membership is <strong>R450 per year</strong> and
            is open to everyone. Sign up online in a few minutes — click
            <em>Create a DAMA profile</em> — and the committee will help you get
            involved. Questions first? Email
            <a href="mailto:membership@dama.org.za">membership@dama.org.za</a>.
          </p>
          <a class="btn btn-primary" href={joinUrl} rel="noopener" target="_blank">
            Create a DAMA profile
          </a>
          <p class="meta mt-3">
            Organisations: there is no corporate membership, but you can request
            Corporate Certificates —
            <a href="mailto:membership@dama.org.za">email us</a> to arrange.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>Membership questions</h2>
      </div>
      <div class="faq">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
