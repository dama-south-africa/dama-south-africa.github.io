---
import Layout from '../layouts/Layout.astro';

const benefits = [
  'Access to monthly chapter meetings and presentations',
  'Participation in the special interest groups',
  'Guidance on CDMP certification pathways',
  'Mentoring and networking with regional data professionals',
  'Connection to the global DAMA International community',
];

// Online membership join portal — create a DAMA profile.
const joinUrl = 'https://join.mymembership.co.za/Join/Bio';
---

<Layout title="Become a Member — DAMA South Africa">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Membership</span>
        <h1>Become a Member</h1>
        <p class="lead">
          Join a community of data management practitioners across South Africa
          and take part in everything the chapter offers.
        </p>
      </div>

      <div class="grid grid-2">
        <div class="prose">
          <h3>Why join</h3>
          <ul>
            {benefits.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <div class="card">
          <h3>Ready to join?</h3>
          <p class="meta">Online membership</p>
          <p>
            Sign up online through our membership portal — it only takes a few
            minutes. Questions first? Email
            <a href="mailto:membership@dama.org.za">membership@dama.org.za</a>.
          </p>
          <a class="btn btn-primary" href={joinUrl} rel="noopener" target="_blank">
            Create a DAMA profile
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
