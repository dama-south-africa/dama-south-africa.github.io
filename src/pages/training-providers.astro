---
import Layout from '../layouts/Layout.astro';

const providers = [
  {
    name: 'Modelware Systems (Pty) Ltd',
    url: 'https://www.modelwaresystems.com/',
    logo: '/modelware-logo.png',
    badge: 'DAMA International Registered Education Provider (REP)',
    tagline: 'Accredited for all CDMP certification',
    blurb:
      'Modelware Systems is a DAMA International Registered Education Provider (REP), accredited to deliver training across the full Certified Data Management Professional (CDMP) certification. Its courses are built directly on the DAMA-DMBOK and are instructor-led by certified professionals, delivered online or in person using case studies and real-world exercises.',
    offerings: [
      'CDMP Data Management Fundamentals — a four-day course covering the DMBOK, with 700+ practice questions, to prepare for the Fundamentals exam',
      'Specialist tracks: Data Governance, Data Quality, Data Architecture, Data Modelling, Metadata Management, Data Integration & Interoperability, and Reference & Master Data',
      'Exam preparation across the CDMP Associate, Practitioner and Master levels',
    ],
  },
  {
    name: 'Info.Blueprint',
    url: 'https://infoblueprint.co.za/',
    logo: '/infoblueprint-logo.png',
    badge: 'Training Partner — Data Quality',
    tagline: 'Data Quality training for CDMP',
    blurb:
      'Info.Blueprint is an information management consultancy with more than 18 years of experience. For CDMP, it provides training in Data Quality — supporting practitioners who are specialising in the Data Quality knowledge area of the DMBOK.',
    offerings: [
      'Practical Data Quality Management — practical training in the Data Quality knowledge area of the DMBOK',
    ],
  },
];

const faq = [
  {
    q: 'Who offers CDMP certification training in South Africa?',
    a: "Modelware Systems — a DAMA International Registered Education Provider (REP) — delivers CDMP certification training across all levels in South Africa. DAMA South Africa also runs a weekly CDMP Q&A webinar to support members preparing for the exams.",
  },
  {
    q: 'Is Modelware Systems a DAMA-accredited training provider?',
    a: "Yes. Modelware Systems is a DAMA International Registered Education Provider (REP), accredited to deliver training across the full Certified Data Management Professional (CDMP) certification, from the Fundamentals exam through the specialist areas.",
  },
  {
    q: 'What CDMP-related training does Info.Blueprint provide?',
    a: "Info.Blueprint provides Data Quality training, supporting practitioners who are specialising in the Data Quality knowledge area of the DMBOK within the CDMP pathway.",
  },
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'CDMP Certification Training',
  description:
    'DMBOK-based training that prepares data professionals for the DAMA International Certified Data Management Professional (CDMP) certification, across the Associate, Practitioner and Master levels.',
  provider: {
    '@type': 'EducationalOrganization',
    name: 'Modelware Systems (Pty) Ltd',
    url: 'https://www.modelwaresystems.com/',
    description:
      'DAMA International Registered Education Provider (REP) for CDMP certification training.',
  },
  educationalCredentialAwarded: 'Certified Data Management Professional (CDMP)',
  about: 'Data management, DAMA-DMBOK, CDMP certification',
  inLanguage: 'en',
};
---

<Layout
  title="Training Providers — DAMA South Africa"
  description="DAMA South Africa's training partners — Modelware Systems, a DAMA International Registered Education Provider (REP), and Info.Blueprint — deliver DMBOK-based data management training and CDMP certification preparation."
  faq={faq}
  jsonld={[courseSchema]}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Training</span>
        <h1>Training Providers</h1>
        <p class="lead">
          Formal, DMBOK-based data management training and CDMP certification
          preparation are delivered through our accredited training partners.
        </p>
      </div>
      <div class="prose">
        <p>
          DAMA South Africa guides and supports members on the path to the
          globally recognised Certified Data Management Professional (CDMP)
          credential, including a weekly CDMP Q&amp;A webinar. Formal,
          DMBOK-aligned training is delivered through our training partners.
          Modelware Systems is a DAMA International Registered Education Provider
          (REP), accredited to deliver training across the full CDMP
          certification, while Info.Blueprint provides Data Quality training
          within the CDMP pathway.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="provider-list">
        {
          providers.map((p) => (
            <article class="provider-card">
              <div class="provider-logo">
                <img src={p.logo} alt={`${p.name} logo`} loading="lazy" />
              </div>
              <div class="provider-head">
                <span class="provider-badge">{p.badge}</span>
                <h2>{p.name}</h2>
                <p class="provider-tagline">{p.tagline}</p>
              </div>
              <p>{p.blurb}</p>
              <h3 class="provider-sub">Training offered</h3>
              <ul>
                {p.offerings.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
              <a class="btn btn-primary" href={p.url} rel="noopener" target="_blank">
                Visit {p.name}
              </a>
            </article>
          ))
        }
      </div>
      <p class="mt-3 provider-note">
        Interested in CDMP training or certification? Email
        <a href="mailto:membership@dama.org.za">membership@dama.org.za</a> and we
        will point you to the right course, or come along to the weekly CDMP
        Q&amp;A webinar.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>CDMP training questions</h2>
      </div>
      <div class="faq">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .provider-list {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    max-width: 1000px;
  }
  .provider-card {
    background: #fff;
    border: 1px solid var(--border, #e6e8ef);
    border-radius: 14px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }
  .provider-logo {
    height: 96px;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .provider-logo img {
    max-height: 96px;
    max-width: 300px;
    width: auto;
    object-fit: contain;
  }
  .provider-head {
    margin-bottom: 1rem;
  }
  .provider-badge {
    display: inline-block;
    margin-bottom: 0.6rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--blue-tint, #eaecf6);
    color: var(--blue, #243090);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .provider-card h2 {
    margin: 0 0 0.2rem;
    font-size: 1.35rem;
  }
  .provider-tagline {
    margin: 0;
    color: var(--blue, #243090);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .provider-sub {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 1.25rem 0 0.5rem;
  }
  .provider-card ul {
    margin: 0 0 1.5rem;
    padding-left: 1.1rem;
  }
  .provider-card li {
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }
  .provider-card .btn {
    margin-top: auto;
    align-self: flex-start;
  }
  .provider-note {
    max-width: 1000px;
  }
</style>
