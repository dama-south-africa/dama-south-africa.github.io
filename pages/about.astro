---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — DAMA South Africa">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">About us</span>
        <h1>About DAMA South Africa</h1>
        <p class="lead">
          DAMA South Africa is a local chapter of DAMA International, the global
          not-for-profit association for data management professionals.
        </p>
      </div>
      <div class="prose">
        <p>
          Our mission is to promote the understanding, development and practice
          of managing data and information as key enterprise assets. Established
          in 2006, the chapter hosts monthly meetings featuring educational
          presentations and networking opportunities, and nurtures a community
          of data professionals who recognise the value of data to their
          organisations.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Supporting data professionals</h2>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <h3>Knowledge sharing</h3>
          <p>Special interest groups and monthly meetings where members exchange practical experience across data management disciplines.</p>
        </div>
        <div class="card">
          <h3>CDMP certification</h3>
          <p>Guidance on the Certified Data Management Professional programme and its certification levels.</p>
        </div>
        <div class="card">
          <h3>Mentoring</h3>
          <p>Initiatives that pair experienced practitioners with professionals developing their data management careers.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
