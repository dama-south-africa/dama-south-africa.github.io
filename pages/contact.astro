---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — DAMA South Africa">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Contact</span>
        <h1>Get in touch</h1>
        <p class="lead">
          Questions about membership, meetings or the chapter? We'd love to hear
          from you.
        </p>
      </div>

      <div class="grid grid-2">
        <div class="prose">
          <p>
            All enquiries are handled by the chapter committee. Email us and
            we'll get back to you as soon as we can.
          </p>
          <p>
            For meeting dates and to RSVP, see the
            <a href="/community/">Community</a> page. To join, visit
            <a href="/become-a-member/">Become a Member</a>.
          </p>
        </div>
        <div class="card">
          <h3>Email the chapter</h3>
          <p class="meta">General &amp; membership enquiries</p>
          <p>
            <a href="mailto:membership@dama.org.za">membership@dama.org.za</a>
          </p>
          <a
            class="btn btn-primary"
            href="mailto:membership@dama.org.za?subject=Enquiry%20from%20the%20website"
          >
            Send an email
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
