---
import Layout from '../layouts/Layout.astro';

const offerings = [
  {
    title: 'Monthly chapter meetings',
    body: 'Educational presentations, discussion and networking on the third Wednesday of every month.',
    href: '/community/',
    link: "See what's on",
    icon: 'calendar',
  },
  {
    title: 'CDMP certification',
    body: 'Guidance and support on the Certified Data Management Professional pathways, at every level.',
    href: '/about/',
    link: 'Learn more',
    icon: 'award',
  },
  {
    title: 'Special interest groups',
    body: 'Focused communities on data protection, big data & data science, and data modeling.',
    href: '/community/',
    link: 'Join a group',
    icon: 'users',
  },
  {
    title: 'Mentoring',
    body: 'Connecting experienced practitioners with data professionals growing their careers.',
    href: '/about/',
    link: 'About mentoring',
    icon: 'growth',
  },
];

const icons: Record<string, string> = {
  calendar:
    '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/>',
  award:
    '<circle cx="12" cy="9" r="5"/><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"/>',
  users:
    '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 6a3 3 0 0 1 0 6M17 20a6.5 6.5 0 0 0-3-5.5"/>',
  growth:
    '<path d="M3 17l6-6 4 4 7-7"/><path d="M21 8v5M21 8h-5"/><path d="M3 21h18"/>',
};
---

<Layout title="DAMA South Africa — Data Management Community">
  <!-- ===== Hero (clean & typographic) ===== -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Chapter of DAMA International · Est. 2006</span>
      <h1>Advancing the practice of data management in South&nbsp;Africa</h1>
      <p>
        DAMA South Africa is a community of technical and business professionals
        dedicated to advancing the concepts and practices of information and
        data management.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/become-a-member/">Become a Member</a>
        <a class="btn btn-outline" href="/community/">Explore the community</a>
      </div>
    </div>
  </section>

  <!-- ===== Stat strip ===== -->
  <section class="container" style="margin-top:-1rem;">
    <div class="stats">
      <div class="stat"><div class="num">2006</div><div class="label">Established</div></div>
      <div class="stat"><div class="num">Monthly</div><div class="label">Chapter meetings</div></div>
      <div class="stat"><div class="num">3</div><div class="label">Special interest groups</div></div>
      <div class="stat"><div class="num">CDMP</div><div class="label">Certification pathways</div></div>
    </div>
  </section>

  <!-- ===== Intro ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who we are</span>
        <h2>A professional community for data management</h2>
        <p class="lead">
          Established in 2006, DAMA South Africa promotes the understanding,
          development and practice of managing data and information as key
          enterprise assets — bringing practitioners together through meetings,
          special interest groups, certification and mentoring.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== What we offer ===== -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we offer</span>
        <h2>Ways to learn and connect</h2>
      </div>
      <div class="grid grid-4">
        {
          offerings.map((o) => (
            <div class="card">
              <div class="icon">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[o.icon]}
                />
              </div>
              <h3>{o.title}</h3>
              <p>{o.body}</p>
              <a class="card-link" href={o.href}>
                {o.link} &rarr;
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== CTA band ===== -->
  <section class="section">
    <div class="container">
      <div class="cta">
        <svg
          class="globe-motif"
          viewBox="0 0 200 200"
          fill="none"
          stroke="#ffffff"
          stroke-width="1.2"
          aria-hidden="true"
        >
          <circle cx="100" cy="100" r="90" />
          <ellipse cx="100" cy="100" rx="40" ry="90" />
          <ellipse cx="100" cy="100" rx="72" ry="90" />
          <line x1="10" y1="100" x2="190" y2="100" />
          <path d="M22 60 H178 M22 140 H178" />
        </svg>
        <h2>Become part of the community</h2>
        <p>
          Join a network of practitioners who treat data as a genuine enterprise
          asset — and help shape data management practice across the region.
        </p>
        <a class="btn btn-ghost-light" href="/become-a-member/">Become a Member</a>
      </div>
    </div>
  </section>
</Layout>
